# ==============================================================================
# Regal Fitness - Backend Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this template: cp .env.example .env
# 2. Update with your local/staging/production values.
# 3. NEVER commit the actual .env file or real secrets to Git.
# ==============================================================================

# Application Settings
APP_NAME="Regal Fitness API"
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & Secrets (CHANGE TO CRYPTOGRAPHICALLY SECURE SECRETS IN PRODUCTION)
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=change_this_to_a_secure_random_server_secret_in_production
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_key_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OTP_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=10
OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60

# Trusted Reverse-Proxy IP Addresses (comma-separated IPv4/IPv6)
# X-Forwarded-For is ONLY honoured when the direct TCP peer appears in this list.
# Leave empty to always use the direct connection IP (safe default for direct deployments).
# Example for nginx on the same host: TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=

# SMS Provider Configuration ("mock", "console", "twilio")
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Integration Switches
WHATSAPP_AUTOMATION_ENABLED=false

# CORS Settings (JSON string or comma-separated list of allowed origins)
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/regal_fitness_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
