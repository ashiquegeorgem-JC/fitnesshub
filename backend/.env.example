# ==============================================================================
# Regal Fitness - Backend Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this template: cp .env.example .env
# 2. Update with your local/staging/production values.
# 3. NEVER commit the actual .env file or real secrets to Git.
# ==============================================================================

# Application Settings
APP_NAME="Regal Fitness API"
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Settings (JSON string or comma-separated list of allowed origins)
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/regal_fitness_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
